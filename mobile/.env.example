# ── Backend (Spring Boot) ────────────────────────────────────────────────
# Use your machine's LAN IP (not "localhost") when testing on a physical
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8080

# Base URL for the STOMP-over-WebSocket endpoint exposed by the backend.
EXPO_PUBLIC_WS_URL=ws://192.168.1.10:8080/ws

# URL of the deployed web app.
EXPO_PUBLIC_WEB_APP_URL=

# ── Firebase ─────────────
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_ANDROID_API_KEY=
EXPO_PUBLIC_FIREBASE_IOS_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ── Google Sign-In (OAuth client IDs from Google Cloud Console) ────────
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# ── EmailJS ───────────────
EXPO_PUBLIC_EMAILJS_SERVICE_ID=
EXPO_PUBLIC_EMAILJS_TEMPLATE_ID=
EXPO_PUBLIC_EMAILJS_PUBLIC_KEY=